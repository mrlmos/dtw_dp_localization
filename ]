def freq_shift(signal, f_shift, fs=FS) -> np.ndarray:
    omega = np.pi - 2 * np.pi * f_shift / fs
    phase = np.arange(len(signal)) * 1j
    return signal * np.exp(phase * omega)


def ressonant_filter(x_k: np.ndarray, r: float = 0.99) -> np.ndarray:
    b = [1.0]
    a = [1.0, r]
    return lfilter(b, a, x_k)


